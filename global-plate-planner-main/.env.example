# AI chatbot (Chef AI). Any OpenAI-compatible API works. Restart `npm run dev` after editing.
# Free option: get a key at https://aistudio.google.com/apikey and use the Gemini values below.
AI_API_KEY=
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-2.0-flash

# OpenAI instead:
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
